{
	"compilerOptions": {
		"baseUrl": "./src",
		"paths": {
			"@app/*": ["app/*"],
			"@assets": ["assets"],
			"@assets/*": ["assets/*"],
			"@components": ["components"],
			"@components/*": ["components/*"],
			"@context": ["context"],
			"@context/*": ["context/*"],
			"@database": ["database"],
			"@database/*": ["database/*"],
			"@hooks": ["hooks"],
			"@hooks/*": ["hooks/*"],
			"@lib/*": ["lib/*"],
			"@public/*": ["../public/*"],
			"@styles": ["styles"],
			"@styles/*": ["styles/*"],
			"@utils": ["utils"],
			"@utils/*": ["utils/*"],
			"~/*": ["*"]
		},
		"plugins": [{ "name": "next" }]
	},
	"exclude": ["node_modules"],
	"extends": "@hyoretsu/tsconfig/frontend",
	"include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"]
}
